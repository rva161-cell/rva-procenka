# Временный конфиг до получения сертификата: только проверка Let's Encrypt по http
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;
    server_tokens off;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 200 "RVA: сервер настраивается\n"; add_header Content-Type text/plain; }
}
